{
  "name": "@brpaz/brunopazdev",
  "description": "Personal website for Bruno Paz",
  "author": {
    "name": "Bruno Paz",
    "email": "info@brunopaz.dev",
    "url": "https://brunopaz.dev"
  },
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "format:check": "prettier --check src/**/*.{astro,ts,js}",
    "format": "prettier --write src/**/*.{astro,ts,js}",
    "lint": "npm-run-all lint:*",
    "lint:js": "eslint src",
    "lint:js:fix": "eslint src --fix",
    "lint:astro": "astro check",
    "lint:md": "markdownlint src/content/**/*.mdx",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:lh": "lhci collect",
    "test:lh:report": "lhci open",
    "icons:optimize": "svgo -r --config=svgo.config.js --input=src/assets/icons"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@sarissa/pagination": "1.0.3",
    "@types/js-yaml": "4.0.9",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.5.0",
    "@typescript-eslint/parser": "8.70.0",
    "astro": "7.3.2",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.11.0",
    "js-yaml": "5.4.1",
    "lighthouse-cli": "0.1.2",
    "markdown-it": "15.0.1",
    "markdownlint-cli": "0.49.1",
    "node-fetch": "3.3.2",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@splidejs/splide": "^4.1.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro-favicons": "^3.1.6",
    "astro-loading-indicator": "^0.9.0",
    "canvaskit-wasm": "^0.42.0",
    "satori": "^0.33.4",
    "slugify": "^1.6.9"
  }
