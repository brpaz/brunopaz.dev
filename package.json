{
  "name": "@brpaz/brunopazdev",
  "description": "Personal website for Bruno Paz",
  "author": {
    "name": "Bruno Paz",
    "email": "info@brunopaz.dev",
    "url": "https://brunopaz.dev"
  },
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "format:check": "prettier --check src/**/*.{astro,ts,js}",
    "format": "prettier --write src/**/*.{astro,ts,js}",
    "lint": "npm-run-all lint:*",
    "lint:js": "eslint src",
    "lint:js:fix": "eslint src --fix",
    "lint:astro": "astro check",
    "lint:md": "markdownlint src/content/**/*.mdx",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:lh": "lhci collect",
    "test:lh:report": "lhci open",
    "icons:optimize": "svgo -r --config=svgo.config.js --input=src/assets/icons"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.61.1",
    "@sarissa/pagination": "^1.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.61.1",
    "astro": "^7.3.1",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "js-yaml": "^5.4.1",
    "lighthouse-cli": "^0.1.2",
    "markdown-it": "^15.0.0",
    "markdownlint-cli": "^0.49.0",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@splidejs/splide": "^4.1.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro-favicons": "^3.1.6",
    "astro-loading-indicator": "^0.9.0",
    "canvaskit-wasm": "^0.42.0",
    "satori": "^0.33.4",
    "slugify": "^1.6.9"
  }
