{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "workarounds:typesNodeVersioning"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "reviewers": [
      "brpaz"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "GitHub Actions: pinned updates grouped and automerged on green CI",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Dev tooling: non-major updates grouped and automerged on green CI",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "Container images are reviewed manually and wait a week before a PR can merge",
      "matchDatasources": [
        "docker"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Docker Hub restarts a digest's age whenever a tag is re-pushed, which would keep digest updates pending",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Majors need a human",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "reviewers": [
        "brpaz"
      ]
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/^@playwright//"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": [
        "pnpm"
      ],
      "groupName": "pnpm",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on the first day of the month"
    ],
    "automerge": true
  },
  "prConcurrentLimit": 5,
  "schedule": [
    "before 6am on monday"
  ]
}
